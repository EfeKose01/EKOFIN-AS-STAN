# Bu dosyayı kopyalayıp ".streamlit/secrets.toml" adıyla kaydedin ve kendi
# değerlerinizi girin. secrets.toml asla git'e eklenmemeli (.gitignore'da olmalı).

# --- Google OAuth 2.0 ("Google ile Giriş Yap") ---
# 1) https://console.cloud.google.com/apis/credentials adresinden bir OAuth Client ID oluşturun
#    (Application type: Web application).
# 2) Authorized redirect URI olarak aşağıdaki redirect_uri'yi TAM OLARAK ekleyin.
# 3) cookie_secret rastgele, uzun bir metin olmalı, örn: `openssl rand -hex 32`
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "CHANGE-ME-random-secret-string"

[auth.google]
client_id = "GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# --- Veritabanı ---
# Boş bırakılırsa backend/database.py varsayılan olarak yerel "ekofin.db" (SQLite) kullanır.
# Postgres için örnek:
# DATABASE_URL = "postgresql+psycopg2://kullanici:sifre@host:5432/ekofin"

# --- Mevcut API anahtarları (zaten .env üzerinden de okunuyor) ---
# ANTHROPIC_API_KEY = "sk-ant-..."
# SERPER_API_KEY = "..."
